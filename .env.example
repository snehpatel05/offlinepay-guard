# Copy this file to .env and paste your own test keys locally.
# Never commit the real .env file.

PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Razorpay Test Mode keys. Key ID usually starts with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_secret_here

# Gemini API key from Google AI Studio.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Buildathon demo controls.
OFFLINE_TXN_LIMIT_PAISE=50000
OFFLINE_WALLET_CAP_PAISE=200000
DEMO_ALLOW_SIMULATED_PRELOAD=true
